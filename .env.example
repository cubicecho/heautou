# The issuer: the public URL of this server followed by /oidc. Applications discover the provider at
# <ISSUER_URL>/.well-known/openid-configuration, and browsers are sent to it to sign in, so use the
# address both reach it at. Default http://localhost:<PORT>/oidc, which only this machine can use.
# Behind a TLS-terminating proxy use the https address and set TRUST_PROXY.
# ISSUER_URL=https://auth.example.home/oidc

# Port the server listens on in production (`npm start`, Docker). Default 3000.
# `npm run dev` ignores it: the web app is on 3000 and the API on 8787.
# PORT=3000

# Where the flat files are written: clients.json, users.json, keys.json and oidc/ (sessions, codes, tokens).
# Default data/ in the working directory; /data in Docker. Everything in it is plain text, private keys included.
# DATA_DIR=data

# Proxies in front of this server that may set X-Forwarded-For and X-Forwarded-Proto. Default false (none).
# "1" for one reverse proxy; never "true" when the port is reachable from the internet.
# TRUST_PROXY=1
