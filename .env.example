# The issuer: the public URL of this server followed by /oidc. Applications discover the provider at
# <ISSUER_URL>/.well-known/openid-configuration, and browsers are sent to it to sign in, so use the
# address both reach it at. Default http://localhost:<PORT>/oidc, which only this machine can use.
# Behind a TLS-terminating proxy use the https address and set TRUST_PROXY. A plain http:// issuer on anything
# but localhost logs a warning in production: passwords and tokens would cross the network readable.
# ISSUER_URL=https://auth.example.home/oidc

# Port the server listens on in production (`npm start`, Docker). Default 3000.
# `npm run dev` ignores it: the web app is on 3000 and the API on 8787.
# PORT=3000

# Where the flat files are written: clients.json, users.json, keys.json and oidc/ (sessions, codes, tokens).
# Default data/ in the working directory; /data in Docker. It is plain JSON; set SECRET_KEY to seal the secrets in it.
# DATA_DIR=data

# Proxies in front of this server that may set X-Forwarded-For and X-Forwarded-Proto. Default false (none).
# "1" for one reverse proxy; never "true" when the port is reachable from the internet.
# Without it behind a proxy, every request seems to come from the proxy, and the sign-in rate limits are shared.
# TRUST_PROXY=1

# Seals client secrets and the private signing and cookie keys in DATA_DIR with AES-256-GCM. 32 bytes of base64:
#   openssl rand -base64 32
# Keep it outside DATA_DIR. Without it they are plain text, and boot warns. The next start with a key seals what is
# there; a wrong key stops boot without touching the files. Losing it loses the client secrets and signing keys.
# SECRET_KEY_FILE names a file holding the key instead (a Docker secret: /run/secrets/...) and wins over SECRET_KEY.
# SECRET_KEY=
# SECRET_KEY_FILE=/run/secrets/heautou_secret_key

# To change the key: the new one as SECRET_KEY, the old one here, start once, then remove this. _FILE works too.
# SECRET_KEY_PREVIOUS=

# Optional email, for sending invite and reset links, the forgot-password link and notifications. Set here, it wins
# over Settings, which shows it locked; unset, the SMTP server can be saved under Settings instead. Without either,
# no email is sent and links are copied by hand. smtp:// upgrades with STARTTLS when offered (default port 587);
# smtps:// is TLS from the start (default 465). SMTP_URL_FILE names a file holding the URL instead.
# SMTP_URL=smtp://user:password@mail.example.home:587
# Or one part each. SMTP_SECURE defaults to on for port 465. SMTP_PASSWORD_FILE works too.
# SMTP_HOST=mail.example.home
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# The sender, required with SMTP_URL or SMTP_HOST.
# SMTP_FROM="Heautou <auth@example.home>"

# Profile pictures, in an S3-compatible bucket (RustFS, MinIO, Garage), addressed path-style. Unset, pictures are off
# and the account and users pages say so. Set the endpoint, bucket and keys together: some without the others stops
# boot. A bucket that can't be reached only warns at boot. Keep the bucket private: /users/:id/picture serves them.
# Pictures are not in DATA_DIR, so a backup from Settings leaves them out; back the bucket up on its own.
# Each has a _FILE form (S3_SECRET_ACCESS_KEY_FILE=/run/secrets/...) that wins over it.
# S3_ENDPOINT=http://rustfs:9000
# S3_BUCKET=heautou
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Forward auth (Protected sites): the parent domain the proxy session cookie is set on, so one sign-in covers every
# site under it. Heautou's own host must be under it too. Wins over the domain chosen under Protected sites.
# FORWARD_AUTH_COOKIE_DOMAIN=home.lan

# The reverse proxies that may call /auth/verify, as addresses or CIDR ranges, comma-separated. Unset, loopback and
# whatever TRUST_PROXY trusts may; anyone else gets 403. See docs/forward-auth.md.
# FORWARD_AUTH_TRUSTED_PROXIES=172.30.0.0/24
