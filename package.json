{
  "name": "heautou",
  "private": true,
  "license": "MIT",
  "version": "1.12.0",
  "description": "A minimal OpenID Connect provider for self-hosted environments, with a small web UI for clients and users.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "PORT=8787 ISSUER_URL=${ISSUER_URL:-http://localhost:3000/oidc} node --env-file-if-exists=.env --watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run codegen && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.ts",
    "codegen": "node server/graphql/write-schema.ts && graphql-codegen && tsr generate",
    "check": "npm run check:biome && npm run check:types",
    "check:biome": "biome check --write .",
    "check:types": "npm run codegen && tsc --noEmit -p server && tsc --noEmit -p web",
    "test": "vitest run",
    "backup": "node --env-file-if-exists=.env server/backup.ts"
  },
  "dependencies": {
    "@escape.tech/graphql-armor-max-aliases": "^2.6.2",
    "@escape.tech/graphql-armor-max-depth": "^2.4.2",
    "@radix-ui/react-slot": "^1.5.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "express": "^5.3.0",
    "graphql": "^16.14.2",
    "graphql-query-complexity": "^2.0.0",
    "graphql-yoga": "^5.24.6",
    "lucide-react": "^1.58.0",
    "nodemailer": "10.0.14",
    "oidc-provider": "^9.12.2",
    "openid-client": "^6.8.8",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/router-cli": "^1.167.44",
    "@tanstack/router-plugin": "^1.168.46",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/oidc-provider": "^9.12.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
